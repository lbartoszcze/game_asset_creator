{
  "name": "game_asset_creator",
  "version": "0.1.0",
  "description": "Runtime asset-creation pipeline for simple-rts-unity: procedural character bodies, sculpted humanoids, gear, and card art. No downloaded models \u2014 everything is built from THREE.js primitives.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./anatomy": "./src/anatomy.js",
    "./sculpt": "./src/sculpt.js",
    "./sculpt-gear": "./sculpt-gear.js",
    "./card-art": "./src/card-art.js",
    "./loader": "./src/loader.js"
  },
  "files": [
    "src",
    "assets",
    "pipeline",
    "pipeline.config.example.json"
  ],
  "keywords": [
    "threejs",
    "procedural-generation",
    "game-assets",
    "rts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "scripts": {
    "test": "node --test 'tests/*.test.mjs'",
    "setup": "node pipeline/setup.js"
  },
  "bin": {
    "game-asset-create": "pipeline/cli.js"
  }
}
